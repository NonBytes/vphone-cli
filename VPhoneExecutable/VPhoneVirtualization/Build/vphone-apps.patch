+// ListVersions returns available external version identifiers for app.
+func (s *Store) ListVersions(ctx context.Context, app appstore.App) (appstore.ListVersionsOutput, error) {
+	acct, err := s.Account()
+	if err != nil {
+		return appstore.ListVersionsOutput{}, err
+	}
+	return call(ctx, func() (appstore.ListVersionsOutput, error) {
+		return s.as.ListVersions(appstore.ListVersionsInput{Context: ctx, Account: acct, App: app})
+	})
+}
