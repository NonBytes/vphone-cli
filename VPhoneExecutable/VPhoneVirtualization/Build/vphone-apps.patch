+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+
+	"github.com/majd/ipatool/v2/pkg/appstore"
+	"github.com/securityvoid/vphone-apps/internal/store"
+)
+
+const versionsUsage = `usage: vphone-apps versions --id <bundleId>
+Lists available App Store external version identifiers as JSON.
+`
+
+type versionLister interface {
+	ListVersions(ctx context.Context, app appstore.App) (appstore.ListVersionsOutput, error)
+}
+
+func (a *app) versions(ctx context.Context, args []string) int {
+	fs := flag.NewFlagSet("versions", flag.ContinueOnError)
+	var id string
+	fs.StringVar(&id, "id", "", "")
+	words, code, done := a.parse(fs, versionsUsage, args)
+	if done {
+		return code
+	}
+	if id == "" && len(words) == 1 {
+		id = words[0]
+	}
+	if id == "" {
+		return a.usageError(versionsUsage, "--id is required")
+	}
+	st, err := a.newStore()
+	if err != nil {
+		return a.report(fail("versions", "%s", err.Error()))
+	}
+	lister, ok := st.(versionLister)
+	if !ok {
+		return a.report(fail("versions", "store does not support version listing"))
+	}
+	var appInfo appstore.App
+	if f := bounded(ctx, a.to.Select, "versions", func(cx context.Context) error {
+		got, err := st.Lookup(cx, id)
+		if errors.Is(err, store.ErrAppNotFound) {
+			return fmt.Errorf("no app with bundle id %s", id)
+		}
+		appInfo = got
+		return err
+	}); f != nil {
+		return a.report(f)
+	}
+	var out appstore.ListVersionsOutput
+	if f := bounded(ctx, a.to.Select, "versions", func(cx context.Context) error {
+		var err error
+		out, err = lister.ListVersions(cx, appInfo)
+		return err
+	}); f != nil {
+		return a.report(f)
+	}
+	// Reverse to newest-first for UI selection.
+	ids := make([]string, 0, len(out.ExternalVersionIdentifiers))
+	for i := len(out.ExternalVersionIdentifiers) - 1; i >= 0; i-- {
+		ids = append(ids, out.ExternalVersionIdentifiers[i])
+	}
+	payload := struct {
+		BundleID string   `json:"bundle_id"`
+		Latest   string   `json:"latest"`
+		Versions []string `json:"versions"`
+	}{
+		BundleID: appInfo.BundleID,
+		Latest:   out.LatestExternalVersionID,
+		Versions: ids,
+	}
+	enc := json.NewEncoder(a.stdout)
+	if err := enc.Encode(payload); err != nil {
+		return a.report(fail("versions", "%s", err.Error()))
+	}
+	return 0
+}
