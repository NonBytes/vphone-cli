+func isWatchBundleEntry(name string) bool {
+	if !strings.HasPrefix(name, "Payload/") {
+		return false
+	}
+	rest := strings.TrimPrefix(name, "Payload/")
+	slash := strings.IndexByte(rest, '/')
+	if slash < 0 || !strings.HasSuffix(rest[:slash], ".app") {
+		return false
+	}
+	sub := rest[slash+1:]
+	return sub == "Watch" || strings.HasPrefix(sub, "Watch/")
+}
+
+func thinFat64MachO(data []byte) ([]byte, bool) {
+	if len(data) < 28 || binary.BigEndian.Uint32(data[0:4]) != 0xcafebabe {
+		return data, false
+	}
+	count := int(binary.BigEndian.Uint32(data[4:8]))
+	if count < 1 || count >= 20 || len(data) < 8+count*20 {
+		return data, false
+	}
+	hasNon64 := false
+	var arm64Slice []byte
+	for i := 0; i < count; i++ {
+		entry := 8 + i*20
+		cpuType := binary.BigEndian.Uint32(data[entry : entry+4])
+		offset := int(binary.BigEndian.Uint32(data[entry+8 : entry+12]))
+		size := int(binary.BigEndian.Uint32(data[entry+12 : entry+16]))
+		if offset < 0 || size < 4 || offset+size > len(data) {
+			return data, false
+		}
+		sliceMagic := binary.LittleEndian.Uint32(data[offset : offset+4])
+		if sliceMagic != 0xfeedfacf {
+			hasNon64 = true
+		} else if cpuType == 0x0100000c && arm64Slice == nil {
+			arm64Slice = data[offset : offset+size]
+		}
+	}
+	if hasNon64 && arm64Slice != nil {
+		return arm64Slice, true
+	}
+	return data, false
+}
+
+func sanitizeDecryptedIPA(ipaPath string) error {
+	zr, err := zip.OpenReader(ipaPath)
+	if err != nil {
+		return err
+	}
+	needsRewrite := false
+	for _, f := range zr.File {
+		if isWatchBundleEntry(f.Name) {
+			needsRewrite = true
+			break
+		}
+		if f.FileInfo().Mode().IsRegular() && f.UncompressedSize64 >= 28 && f.UncompressedSize64 <= 512<<20 {
+			rc, oerr := f.Open()
+			if oerr == nil {
+				var hdr [8]byte
+				n, _ := io.ReadFull(rc, hdr[:])
+				rc.Close()
+				if n == 8 && binary.BigEndian.Uint32(hdr[0:4]) == 0xcafebabe {
+					cnt := binary.BigEndian.Uint32(hdr[4:8])
+					if cnt >= 1 && cnt < 20 {
+						needsRewrite = true
+						break
+					}
+				}
+			}
+		}
+	}
+	if !needsRewrite {
+		return zr.Close()
+	}
+	cleanPath := ipaPath + ".clean"
+	outFile, err := os.OpenFile(cleanPath, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o600)
+	if err != nil {
+		zr.Close()
+		return err
+	}
+	zw := zip.NewWriter(outFile)
+	for _, f := range zr.File {
+		if isWatchBundleEntry(f.Name) {
+			continue
+		}
+		hdr := f.FileHeader
+		if f.FileInfo().Mode().IsRegular() && f.UncompressedSize64 >= 28 && f.UncompressedSize64 <= 512<<20 {
+			rc, err := f.Open()
+			if err != nil {
+				zw.Close()
+				outFile.Close()
+				zr.Close()
+				_ = os.Remove(cleanPath)
+				return err
+			}
+			var peek [8]byte
+			n, _ := io.ReadFull(rc, peek[:])
+			if n == 8 && binary.BigEndian.Uint32(peek[0:4]) == 0xcafebabe {
+				rest, rerr := io.ReadAll(rc)
+				rc.Close()
+				if rerr != nil {
+					zw.Close()
+					outFile.Close()
+					zr.Close()
+					_ = os.Remove(cleanPath)
+					return rerr
+				}
+				full := append(peek[:], rest...)
+				thinned, changed := thinFat64MachO(full)
+				if changed {
+					hdr.UncompressedSize64 = uint64(len(thinned))
+					hdr.UncompressedSize = uint32(len(thinned))
+				}
+				w, werr := zw.CreateHeader(&hdr)
+				if werr != nil {
+					zw.Close()
+					outFile.Close()
+					zr.Close()
+					_ = os.Remove(cleanPath)
+					return werr
+				}
+				if _, werr := io.Copy(w, bytes.NewReader(thinned)); werr != nil {
+					zw.Close()
+					outFile.Close()
+					zr.Close()
+					_ = os.Remove(cleanPath)
+					return werr
+				}
+				continue
+			}
+			rc.Close()
+		}
+		raw, err := f.OpenRaw()
+		if err != nil {
+			zw.Close()
+			outFile.Close()
+			zr.Close()
+			_ = os.Remove(cleanPath)
+			return err
+		}
+		w, err := zw.CreateRaw(&hdr)
+		if err != nil {
+			zw.Close()
+			outFile.Close()
+			zr.Close()
+			_ = os.Remove(cleanPath)
+			return err
+		}
+		if _, err := io.Copy(w, raw); err != nil {
+			zw.Close()
+			outFile.Close()
+			zr.Close()
+			_ = os.Remove(cleanPath)
+			return err
+		}
+	}
+	if err := zw.Close(); err != nil {
+		outFile.Close()
+		zr.Close()
+		_ = os.Remove(cleanPath)
+		return err
+	}
+	if err := outFile.Close(); err != nil {
+		zr.Close()
+		_ = os.Remove(cleanPath)
+		return err
+	}
+	_ = zr.Close()
+	return os.Rename(cleanPath, ipaPath)
+}
