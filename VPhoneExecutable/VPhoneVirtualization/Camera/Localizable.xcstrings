{
  "sourceLanguage": "en",
  "strings": {
    "VPhone — Mac Camera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Mac Camera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Macカメラ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Mac 카메라"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Camera Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Mac 摄像头"
          }
        }
      }
    },
    "Waiting for Camera permission…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Camera permission…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセス許可を待っています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근 권한 대기 중…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ quyền truy cập camera…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待摄像头权限…"
          }
        }
      }
    },
    "Stop Camera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Camera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 중지"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止摄像头"
          }
        }
      }
    },
    "Camera denied — enable in Privacy & Security → Camera.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera denied — enable in Privacy & Security → Camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスが拒否されました。「プライバシーとセキュリティ」→「カメラ」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 거부되었습니다. 개인정보 보호 및 보안 → 카메라에서 허용하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera bị từ chối — hãy bật trong Quyền riêng tư & Bảo mật → Camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头访问被拒绝，请在“隐私与安全性”→“摄像头”中启用。"
          }
        }
      }
    },
    "No Mac camera found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mac camera found"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのカメラが見つかりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 카메라를 찾을 수 없습니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy camera Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Mac 摄像头"
          }
        }
      }
    },
    "Cannot configure capture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot configure capture"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像の取り込みを設定できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처를 구성할 수 없습니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể cấu hình quay hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法配置视频采集"
          }
        }
      }
    },
    "Camera: %@ — local VM feed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera: %@ — local VM feed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ: %@ — ローカルVMへの映像"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라: %@ — 로컬 VM 영상"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera: %@ — hình ảnh cho VM cục bộ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头：%@ — 本地虚拟机画面"
          }
        }
      }
    },
    "Rotation: 0°": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation: 0°"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転: 0°"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회전: 0°"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay: 0°"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转：0°"
          }
        }
      }
    },
    "Rotation: 90° clockwise": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation: 90° clockwise"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転: 時計回り90°"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회전: 시계 방향 90°"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay: 90° theo chiều kim đồng hồ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转：顺时针90°"
          }
        }
      }
    },
    "Rotation: 180°": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation: 180°"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転: 180°"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회전: 180°"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay: 180°"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转：180°"
          }
        }
      }
    },
    "Rotation: 90° counterclockwise": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation: 90° counterclockwise"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転: 反時計回り90°"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회전: 반시계 방향 90°"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay: 90° ngược chiều kim đồng hồ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转：逆时针90°"
          }
        }
      }
    },
    "Select Camera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Camera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 선택"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择摄像头"
          }
        }
      }
    },
    "iPhone: enable Continuity Camera and connect to this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone: enable Continuity Camera and connect to this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで連係カメラを有効にし、このMacに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 연속성 카메라를 켜고 이 Mac에 연결하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone: bật Camera thông suốt và kết nối với máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone：启用连续互通相机并连接到此 Mac。"
          }
        }
      }
    },
    "%@ (Disconnected)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Disconnected)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（未接続）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (연결 끊김)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Đã ngắt kết nối)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已断开连接）"
          }
        }
      }
    },
    "No camera found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera found"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが見つかりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 찾을 수 없음"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到摄像头"
          }
        }
      }
    },
    "Selected camera disconnected — reconnect it or choose another camera.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected camera disconnected — reconnect it or choose another camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したカメラが切断されました。再接続するか別のカメラを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 카메라의 연결이 끊겼습니다. 다시 연결하거나 다른 카메라를 선택하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera đã chọn bị ngắt kết nối. Hãy kết nối lại hoặc chọn camera khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选摄像头已断开连接，请重新连接或选择其他摄像头。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
