{
  "sourceLanguage": "en",
  "strings": {
    "VPhone — Mac Camera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Mac Camera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Macカメラ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Mac 카메라"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Camera Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPhone — Mac 摄像头"
          }
        }
      }
    },
    "Waiting for Camera permission…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Camera permission…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセス許可を待っています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근 권한 대기 중…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ quyền truy cập camera…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待摄像头权限…"
          }
        }
      }
    },
    "Stop Camera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Camera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 중지"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止摄像头"
          }
        }
      }
    },
    "Camera denied — enable in Privacy & Security → Camera.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera denied — enable in Privacy & Security → Camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスが拒否されました。「プライバシーとセキュリティ」→「カメラ」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 거부되었습니다. 개인정보 보호 및 보안 → 카메라에서 허용하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera bị từ chối — hãy bật trong Quyền riêng tư & Bảo mật → Camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头访问被拒绝，请在“隐私与安全性”→“摄像头”中启用。"
          }
        }
      }
    },
    "No Mac camera found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mac camera found"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのカメラが見つかりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 카메라를 찾을 수 없습니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy camera Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Mac 摄像头"
          }
        }
      }
    },
    "Cannot configure capture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot configure capture"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像の取り込みを設定できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처를 구성할 수 없습니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể cấu hình quay hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法配置视频采集"
          }
        }
      }
    },
    "Camera: %@ — local VM feed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera: %@ — local VM feed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ: %@ — ローカルVMへの映像"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라: %@ — 로컬 VM 영상"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera: %@ — hình ảnh cho VM cục bộ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头：%@ — 本地虚拟机画面"
          }
        }
      }
    },
